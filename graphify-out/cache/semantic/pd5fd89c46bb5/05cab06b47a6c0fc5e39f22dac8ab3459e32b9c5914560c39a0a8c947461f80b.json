l}, {"id": "readme_horaire_type", "label": "Horaire type (m\u00e9diane de boires/jour, cr\u00e9neaux gard\u00e9s si 4 jours sur 10)", "file_type": "concept", "source_file": "README.md", "source_location": "L114-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_modules", "label": "Modules activables et r\u00e9ordonnables (G\u00e9rer les modules)", "file_type": "concept", "source_file": "README.md", "source_location": "L117-L120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un module d\u00e9sactiv\u00e9 dispara\u00eet de l'accueil mais ses donn\u00e9es restent."}, {"id": "readme_module_couches", "label": "Module Couches", "file_type": "concept", "source_file": "README.md", "source_location": "L121-L122", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_module_croissance", "label": "Module Croissance (percentiles OMS, m\u00e9thode LMS)", "file_type": "concept", "source_file": "README.md", "source_location": "L123-L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tout est m\u00e9trique en base ; les unit\u00e9s d'affichage se choisissent dans les Param\u00e8tres. Percentiles 3, 15, 50, 85, 97 de l'OMS = courbes du carnet de sant\u00e9 du Qu\u00e9bec."}, {"id": "readme_normes_oms", "label": "Normes de croissance de l'OMS", "file_type": "concept", "source_file": "README.md", "source_location": "L125-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_module_premieres", "label": "Module Premi\u00e8res de b\u00e9b\u00e9", "file_type": "concept", "source_file": "README.md", "source_location": "L129-L130", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_allaitement", "label": "Allaitement : deux minuteurs Gauche/Droit persistants (kenda.timers.v1)", "file_type": "concept", "source_file": "README.md", "source_location": "L131-L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le minuteur survit \u00e0 la fermeture de la fiche et de l'app ; les t\u00e9t\u00e9es se m\u00ealent aux boires, sans quantit\u00e9."}, {"id": "readme_module_tire_lait", "label": "Module Tire-lait", "file_type": "concept", "source_file": "README.md", "source_location": "L137-L138", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_module_allergenes", "label": "Module Allerg\u00e8nes (expositions, \u00e9tat calcul\u00e9 par l'app)", "file_type": "concept", "source_file": "README.md", "source_location": "L139-L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une seule sorte d'entr\u00e9e (l'exposition, table allergen_exposures) ; l'\u00e9tat est d\u00e9riv\u00e9 : pas introduit, en cours, tol\u00e9r\u00e9 apr\u00e8s 3 expositions sans r\u00e9action, r\u00e9action. Au plus un allerg\u00e8ne non tol\u00e9r\u00e9 par entr\u00e9e. Aucun conseil m\u00e9dical."}, {"id": "readme_guide_allergies_quebec", "label": "Guide d'Allergies Qu\u00e9bec (avril 2024) : 10 allerg\u00e8nes prioritaires", "file_type": "document", "source_file": "README.md", "source_location": "L139-L140", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_a_redonner", "label": "\u00ab \u00c0 redonner \u00bb : allerg\u00e8nes tol\u00e9r\u00e9s pas mang\u00e9s depuis plus de 7 jours", "file_type": "concept", "source_file": "README.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_photos_indexeddb", "label": "Photos r\u00e9duites \u00e0 640 px, cache IndexedDB hors de l'instantan\u00e9 localStorage", "file_type": "rationale", "source_file": "README.md", "source_location": "L145-L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale